{
  "name": "Nova - Get POP Port by Agent Email",
  "integrationType": "custom-rest-actions",
  "actionType": "custom",
  "config": {
    "request": {
      "requestUrlTemplate": "https://gcapi.alektumgroup.com/Service/novaPopPort/${input.userEmail}",
      "requestType": "GET",
      "headers": {
        "Accept": "application/json",
        "Authorization": "${authResponse.token_type} ${authResponse.access_token}",
        "scope": "${credentials.scope}"
      },
      "requestTemplate": "{\n\"userEmail\": \"$!esc.jsonString($!{input.userEmail})\"\n}\n"
    },
    "response": {
      "translationMap": {
        "successValue": "$.success",
        "portValue": "$.data",
        "messageValue": "$.message",
        "errorsValue": "$.errors[*]"
      },
      "translationMapDefaults": {
        "successValue": "false",
        "portValue": "0",
        "messageValue": "\"UNKNOWN\"",
        "errorsValue": "[]"
      },
      "successTemplate": "{\"success\" : ${successValue}, \"port\" : ${portValue}, \"message\" : ${messageValue}, \"errors\" : ${errorsValue} }"
    }
  },
  "contract": {
    "input": {
      "inputSchema": {
        "title": "input",
        "description": "Input for looking up the Nova POP port for an agent.",
        "type": "object",
        "required": [
          "userEmail"
        ],
        "properties": {
          "userEmail": {
            "type": "string",
            "description": "The agent's email address, e.g. agent@alektumgroup.com"
          }
        },
        "additionalProperties": true
      }
    },
    "output": {
      "successSchema": {
        "title": "output",
        "description": "The Nova POP port assigned to the agent.",
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "True when the lookup succeeded."
          },
          "port": {
            "type": "integer",
            "description": "The Nova POP port number for the agent. 0 when no result was returned (HTTP 204)."
          },
          "message": {
            "type": "string",
            "description": "Optional message returned by the API."
          },
          "errors": {
            "type": "array",
            "description": "Any errors returned by the API.",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "secure": false
}
